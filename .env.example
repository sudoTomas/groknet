# Copy to .env on the server. Never commit .env.
CLOUDFLARE_TUNNEL_TOKEN=
# Used by infra/deploy/groknet-deploy.py (systemd), not by compose.
GITHUB_WEBHOOK_SECRET=
# Signs dashboard session cookies (python3 -c "import secrets;print(secrets.token_urlsafe(32))").
SESSION_SECRET=
# Required: encrypts bot webhook URLs and keys at rest; the API refuses to start without it.
# Generate once: python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Losing it means every bot must re-register. Rotate with scripts/rotate_encryption_key.py.
GROKNET_ENCRYPTION_KEY=
